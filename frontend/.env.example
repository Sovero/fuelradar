# FuelRadar frontend — переменные окружения Next.js.
# ВАЖНО: Next.js читает .env-файлы из ЭТОЙ директории (frontend/), а не из корня
# монорепозитория — скопируйте нужные значения в frontend/.env.local для локальной
# разработки (файл в .gitignore, секреты/ключи в репозиторий не попадают).

# --- backend через прокси Next.js (next.config.mjs rewrites) ---
# API_INTERNAL_URL=http://127.0.0.1:8000

# --- карта (T09, R102): по умолчанию — MapLibre GL + OSM-тайлы, бесплатно,
# без ключей «из коробки». Яндекс.Карты — платный сервис, ОПЦИОНАЛЬНАЯ вторая
# реализация того же MapProvider: включается сама, если задать непустой ключ
# ниже (без ключа приложение к Яндекс.Картам вообще не обращается).
# Клиентская переменная — ОБЯЗАН быть префикс NEXT_PUBLIC_, иначе Next.js не
# включит значение в браузерный бандл.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Явный переключатель провайдера карты (необязателен) — переопределяет
# автоопределение по наличию ключа выше. См. lib/map/index.ts.
# NEXT_PUBLIC_MAP_PROVIDER=yandex   # yandex | maplibre

# --- начальный вид карты (R04/R81: без региона, зашитого в код) ---
# Пример ниже — пилотный регион (Краснодар); для другого региона задайте свои
# координаты. Без переменных используется тот же пример как запасной вариант.
# NEXT_PUBLIC_DEFAULT_MAP_LAT=45.0355
# NEXT_PUBLIC_DEFAULT_MAP_LON=38.9753
