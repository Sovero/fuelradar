# FuelRadar — переменные окружения. Только ИМЕНА и примеры; значения — в вашем .env.
# Секреты никогда не попадают в репозиторий (R68).

# --- приложение ---
DEBUG=false
# DATABASE_URL=sqlite:///./fuelradar.db   # dev
# DATABASE_URL=postgresql+psycopg://fuelradar:password@db:5432/fuelradar  # prod (PostGIS)

# --- регион (R04/R81): пилот — Краснодар; данные, не код ---
DEFAULT_REGION_CITY=Краснодар
DEFAULT_REGION_RADIUS_KM=10

# --- источники (T02) ---
# OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
# NETWORK_IMPORT_PATH=путь к CSV/JSON со списками сетей (иначе источник DEGRADED)

# --- дедупликация (T03, §11/§18) ---
# DEDUP_AUTO_MERGE=0.85        # score ≥ порога — автослияние
# DEDUP_NEEDS_REVIEW=0.60      # score ≥ порога — очередь администратору
# DEDUP_WEIGHTS={"coordinates":0.5,"brand":0.2,"address":0.15,"name":0.1,"phone":0.05}

# --- confidence и Score (T04, §8/§10/§18) ---
# CONFIDENCE_SHARE_STRONG=0.80   # доля лучшего статуса → прямой статус
# CONFIDENCE_SHARE_LIKELY=0.60   # доля для LIKELY_AVAILABLE (иначе UNCERTAIN)
# CONFIDENCE_MIN_WEIGHT=0.30     # мин. вес подтверждений для смены статуса (R19.1)
# GPS_BOOST=1.2                  # R40 — отчёт с GPS < 300 м
# GPS_PENALTY=0.6                # R40.1 — отчёт «издалека»
# QUEUE_SECONDS_PER_VEHICLE=80   # R20 — оценка ожидания
# AVG_SPEED_KMH=30               # ASSUMPTION: средняя скорость для travel_time
# SCORE_WEIGHTS={"fuel_available":0.3,"confidence":0.2,"freshness":0.1,"distance":0.15,"travel_time":0.1,"queue":0.1,"user_preferences":0.05}

# --- секреты (R97i/R66/R95i): без значений каналы и входы помечены «не настроены» ---
TELEGRAM_BOT_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
ADMIN_TOKEN=
SMTP_URL=

# --- API и безопасность (T05, §15) ---
# JWT_SECRET=длинная-случайная-строка    # пусто → эфемерный на процесс (только dev)
# COOKIE_SECURE=true                     # включать за HTTPS
# CORS_ORIGINS=https://example.com,https://app.example.com
# RATE_LIMIT_PER_MINUTE=120              # 0 — выключить
# API_CACHE_TTL_SECONDS=30               # кэш списка/карты (R82)
SMTP_FROM=noreply@localhost
PUBLIC_APP_URL=http://localhost:3000
WORKER_TICK_SECONDS=10
WORKER_BACKOFF_MAX_MINUTES=120

# --- карта (T09, R102): базовая подложка — Яндекс.Карты; каталог АЗС не меняется ---
# Клиентская переменная Next.js — должна начинаться с NEXT_PUBLIC_, иначе не попадёт в браузер.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
